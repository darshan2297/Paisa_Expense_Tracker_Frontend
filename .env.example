# Copy this file to `.env` and adjust values for your local setup.
# Any variable prefixed EXPO_PUBLIC_ is inlined into the client bundle at
# build time by Expo — never put secrets behind that prefix.

# Local backend (port 8001): http://localhost:8001/api/v1
# Expo dev server runs on port 8081 (see package.json scripts).
EXPO_PUBLIC_API_URL=http://localhost:8001/api/v1
